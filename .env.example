# Supabase project URL + publishable (anon) key. Safe-ish, but keep server-only anyway.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Random 64-hex secret. Its SHA-256 lives in private.app_secret; every DB request must send it.
APP_DB_KEY=
# Shared login password for the app.
APP_PASSWORD=
# 32+ char random string for iron-session cookie encryption.
SESSION_SECRET=
# Paused-mode interest emails (optional at runtime).
RESEND_API_KEY=
ADMIN_EMAIL=
APP_PAUSED=false

# Name search (optional). Without ANTHROPIC_API_KEY the name search shows "not switched on yet".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
SEARCH_REGION_HINT=Panama
